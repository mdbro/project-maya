      "id": "check-code",
      "prompt": "Write a Python function count_initials(names) that ignores empty or whitespace-only strings and counts the first letter of each stripped name case-insensitively. Show one example."
    },
    {
      "id": "check-prose",
      "prompt": "Write a clear short explanation for new volunteers about labeling seed envelopes: include plant name, harvest month, and storage instructions. Keep a friendly tone and avoid unsupported shelf-life claims."
    },
    {
      "id": "check-extraction",
      "prompt": "Summarize this maintenance log as three bullet points without adding facts: Pump B was inspected Monday. Its seal was replaced Tuesday. A test on Wednesday found no leakage. Pump A was not inspected."
    },
    {
      "id": "check-reasoning",
      "prompt": "Mira has three labeled boxes. Exactly one contains a coin. The red box label says the coin is here. The blue label says the coin is not in the red box. The green label says the coin is in the blue box. Exactly one label is true. Which box contains the coin? Explain briefly."
    },
    {
      "id": "check-tool",
      "prompt": "Use location_lookup to find the stored location for shipment parcel-82. Do not guess the location.",
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "location_lookup",
            "description": "Look up the stored location of a shipment",
            "parameters": {
              "type": "object",
              "properties": {
                "shipment_id": {
                  "type": "string"
                }
              },
              "required": [
                "shipment_id"
              ]
            }
          }
        }
      ],
      "tune": {
        "spec": 1,
        "spec_policy": "existing"
      },
      "purpose": "Exercise ordinary one-row generation through the actual public serving path; the other four requests exercise DSpark grouped verification. This is a required caller check, not a width comparison.",
      "expect": {
        "spec_policy": "existing"
      }
    }
